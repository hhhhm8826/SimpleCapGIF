<Window x:Class="SimpleCapGIF.App.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SimpleCapGIF.App.Converters"
        xmlns:localization="clr-namespace:SimpleCapGIF.Localization;assembly=SimpleCapGIF.Localization"
        Title="{x:Static localization:AppStrings.ToolbarTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SourceInitialized="OnSourceInitialized">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:OptionDisplayConverter x:Key="OptionDisplay" />
    <DataTemplate x:Key="OptionTemplate">
      <TextBlock Text="{Binding Converter={StaticResource OptionDisplay}}" />
    </DataTemplate>
    <Style x:Key="OptionItemStyle" TargetType="ComboBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource OptionDisplay}}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#FF34373F" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="82" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#FFE33B46" />
    </Style>
    <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Window.Resources>
  <Border x:Name="ToolbarRoot" Padding="7" CornerRadius="9" Background="{StaticResource PanelBrush}">
    <Grid>
      <Grid>
        <Grid Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,40,0">
            <Button x:Name="RecordButton"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="{x:Static localization:AppStrings.Record}"
                    AutomationProperties.Name="{x:Static localization:AppStrings.Record}"
                    Click="OnRecordClick">
              <Ellipse Width="11" Height="11" Fill="White" />
            </Button>
            <Button x:Name="FullScreenButton" Content="{x:Static localization:AppStrings.FullScreen}" Click="OnFullScreenClick" />
            <Button Content="{x:Static localization:AppStrings.Location}" ToolTip="{x:Static localization:AppStrings.ChangeSaveLocation}" AutomationProperties.Name="{x:Static localization:AppStrings.ChangeSaveLocation}" Click="OnFolderClick" />
            <Button Content="{x:Static localization:AppStrings.Folder}" ToolTip="{x:Static localization:AppStrings.OpenSaveFolder}" AutomationProperties.Name="{x:Static localization:AppStrings.OpenSaveFolder}" Click="OnOpenFolderClick" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" AutomationProperties.Name="{x:Static localization:AppStrings.FormatLabel}" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" ItemTemplate="{StaticResource OptionTemplate}" ItemContainerStyle="{StaticResource OptionItemStyle}" />
            <ComboBox Grid.Column="1" AutomationProperties.Name="{x:Static localization:AppStrings.OutputSize}" MinWidth="120" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" ItemTemplate="{StaticResource OptionTemplate}" ItemContainerStyle="{StaticResource OptionItemStyle}" />
            <ComboBox x:Name="FrameRateComboBox" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static localization:AppStrings.FrameRate}" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFps}" ItemTemplate="{StaticResource OptionTemplate}" ItemContainerStyle="{StaticResource OptionItemStyle}" />
          </Grid>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,40,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
          <Button x:Name="StopButton"
                  Style="{StaticResource ActionButtonStyle}"
                  ToolTip="{x:Static localization:AppStrings.Stop}"
                  AutomationProperties.Name="{x:Static localization:AppStrings.Stop}"
                  Click="OnStopClick">
            <Rectangle Width="11" Height="11" Fill="White" />
          </Button>
          <TextBlock Text="{Binding ElapsedText}" Foreground="White" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas" />
          <TextBlock Text="{Binding EstimatedText}" VerticalAlignment="Center" Margin="8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSizeWarning}" Value="True">
                    <Setter Property="Foreground" Value="#FFFF4D58" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <TextBlock Text="{x:Static localization:AppStrings.Saving}" Foreground="White" Margin="12,6,52,6" Visibility="{Binding IsEncoding, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,40,0" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSizeWarning}" Value="True">
                    <Setter Property="Foreground" Value="#FFFF4D58" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Content="{x:Static localization:AppStrings.Folder}" ToolTip="{x:Static localization:AppStrings.OpenSaveFolder}" AutomationProperties.Name="{x:Static localization:AppStrings.OpenSaveFolder}" Click="OnOpenFolderClick" />
        </StackPanel>
      </Grid>

      <Button x:Name="ExitButton"
              Style="{StaticResource ExitButtonStyle}"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Content="×"
              ToolTip="{x:Static localization:AppStrings.Exit}"
              AutomationProperties.Name="{x:Static localization:AppStrings.Exit}"
              Click="OnExitClick" />
    </Grid>
  </Border>
</Window>
